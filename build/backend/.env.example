# Copy to .env and adjust as needed. Every value below has a sane default
# baked into app/config.py, so the backend runs with zero setup too.

# mock = built-in simulator plays gateway heartbeats, zero hardware needed
# live = only real MQTT traffic / real API calls drive the data
MODE=mock

# SQLite by default. For production point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouse
DATABASE_URL=sqlite:///./smart_warehouse.db

MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=warehouse/racks

HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_TIMEOUT_SEC=180

# Optional local AI assistant (chat). Leave as-is if you don't run Ollama -
# the /api/chat endpoint just reports modelReachable=false and the rest of
# the app works normally.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
